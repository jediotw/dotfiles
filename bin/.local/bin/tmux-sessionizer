#!/usr/bin/env bash
set -euo pipefail

PROJECTS_DIR="$HOME/projects"

menu=""

# 1. Existing tmux sessions
if tmux ls &>/dev/null; then
    while IFS= read -r sess; do
        menu+="[switch] ${sess}"$'\t'"${sess}"$'\t'"${sess}"$'\t'"switch"$'\n'
    done < <(tmux list-sessions -F '#{session_name}')
fi

# 2. Projects
if [[ $# -eq 1 ]]; then
    selected="$1"

    [[ -d "$selected" ]] || {
        echo "Project not found: $selected"
        exit 1
    }

    menu+="[new] $(basename "$selected")"$'\t'"$(basename "$selected")"$'\t'"$selected"$'\t'"project"$'\n'
else
    for dir in "$PROJECTS_DIR"/*/; do
        [[ -d "$dir" ]] || continue

        name=$(basename "$dir")

        tmux has-session -t="$name" 2>/dev/null && continue

        menu+="[new] ${name}"$'\t'"${name}"$'\t'"${dir}"$'\t'"project"$'\n'
    done
fi

# 3. Git worktrees
for dir in "$PROJECTS_DIR"/*/; do
    [[ -d "$dir/.git" || -f "$dir/.git" ]] || continue

    (
        cd "$dir"
        git worktree prune 2>/dev/null
    ) || true

    wt_dir="${dir}.worktrees"
    [[ -d "$wt_dir" ]] || continue

    project_name=$(basename "$dir")

    for branch_dir in "$wt_dir"/*/; do
        [[ -d "$branch_dir" ]] || continue

        branch_name=$(basename "$branch_dir")
        sess_name="${project_name}(${branch_name})"

        if tmux has-session -t="$sess_name" 2>/dev/null; then
            label="[switch] ${project_name} (${branch_name}) [worktree]"
            type="switch"
        else
            label="[new] ${project_name} (${branch_name}) [worktree]"
            type="worktree"
        fi

        menu+="${label}"$'\t'"${sess_name}"$'\t'"${branch_dir}"$'\t'"${type}"$'\n'
    done
done

[[ -z "$menu" ]] && exit 0

selection=$(
    printf '%s' "$menu" |
        LC_ALL=C sort -t$'\t' -k4,4r -k1,1 |
        fzf --height 100% --delimiter=$'\t' --with-nth=1
)

[[ -z "$selection" ]] && exit 0

sess=$(printf '%s' "$selection" | cut -f2)
path=$(printf '%s' "$selection" | cut -f3)
type=$(printf '%s' "$selection" | cut -f4)

# Existing session → switch/attach
if [[ "$type" == "switch" ]]; then
    if [[ -n "${TMUX:-}" ]]; then
        tmux switch-client -t "$sess"
    else
        tmux attach-session -t "$sess"
    fi
    exit 0
fi

# New project/worktree session
if [[ -n "${TMUX:-}" ]]; then
    tmux new-session -d -s "$sess" -c "$path"
    tmux switch-client -t "$sess"
else
    tmux new-session -s "$sess" -c "$path"
fi
